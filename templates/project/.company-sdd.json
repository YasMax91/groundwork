{
  "runner": "sail",
  "database": {
    "default": "mysql"
  },
  "commands": {
    "format": "./vendor/bin/sail pint",
    "format_test": "./vendor/bin/sail composer format:test",
    "analyse": "./vendor/bin/sail composer analyse",
    "test": "./vendor/bin/sail artisan test"
  },
  "gates": {
    "format_on_edit": true,
    "analyse_on_stop": true,
    "test_on_stop": true,
    "trim_tool_output": false,
    "enforce_runner": true,
    "lock_shipped_migrations": true,
    "lock_edits_in_discovery": false
  },
  "memory": {
    "session_context": true,
    "checkpoint": true,
    "impact_cache": true
  },
  "docs": {
    "frontend": "ai/frontend"
  }
}
