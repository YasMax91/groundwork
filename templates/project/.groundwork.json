{
  "runner": "sail",
  "database": {
    "default": "mysql"
  },
  "commands": {},
  "gates": {
    "format_on_edit": true,
    "analyse_on_stop": true,
    "test_on_stop": true,
    "openapi_on_stop": true,
    "coverage_claim": true,
    "task_intent": true,
    "agent_contract": true,
    "trim_tool_output": false,
    "enforce_runner": true,
    "lock_shipped_migrations": true,
    "lock_edits_in_discovery": false,
    "test_db_lock": true,
    "test_lock_wait_seconds": 45,
    "check_unpushed": true
  },
  "estimates": {
    "ledger": true,
    "idle_seconds": 120,
    "min_sample": 5
  },
  "memory": {
    "session_context": true,
    "checkpoint": true,
    "impact_cache": true
  },
  "docs": {
    "frontend": "ai/frontend"
  },
  "ui": {
    "statusline": false,
    "status_messages": true
  }
}
