{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" session-start.sh",
            "statusMessage": "Groundwork: loading project state…"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" pre-compact.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" task-intent.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^groundwork:(grounded-researcher|adversarial-verifier|conformance-reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" agent-contract.sh",
            "statusMessage": "Groundwork: checking the agent's output contract…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" stdin-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" lane-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" pre-tool-guard.sh",
            "statusMessage": "Groundwork: checking command…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" format-on-edit.sh",
            "statusMessage": "Groundwork: formatting…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" trim-output.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" plain-language.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" done-gate.sh",
            "statusMessage": "Groundwork: static analysis…"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" test-gate.sh",
            "statusMessage": "Groundwork: running tests…"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" openapi-gate.sh",
            "statusMessage": "Groundwork: checking OpenAPI…"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" slice-gate.sh",
            "statusMessage": "Groundwork: checking the slice ledger…"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" coverage-claim.sh",
            "statusMessage": "Groundwork: checking the coverage claim…"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" defect-scan.sh",
            "statusMessage": "Groundwork: scanning for defect classes…"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" estimate-claim.sh",
            "statusMessage": "Groundwork: checking the estimate…"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" estimate-docs.py"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" plain-language.sh",
            "statusMessage": "Groundwork: checking the wording…"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" ledger-record.sh",
            "statusMessage": "Groundwork: recording what the task took…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" handoff-gate.sh",
            "statusMessage": "Groundwork: checking the frontend handoff…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/in-cwd.sh\" lane-idle.py"
          }
        ]
      }
    ]
  }
}
